# Copy this file to ".env.local" (git-ignored) and fill in real values.
# Vite only exposes vars prefixed with VITE_ to the browser.

# Base URL of the user/order service. No trailing slash.
# Local dev example:    http://localhost:8080
# EC2 dev example:      http://ec2-XX-XX-XX-XX.eu-north-1.compute.amazonaws.com:8080
VITE_USER_SERVICE_URL=http://localhost:8080

# Base URL of the product service. No trailing slash.
# Local dev example:    http://localhost:8082
# EC2 dev example:      http://ec2-XX-XX-XX-XX.eu-north-1.compute.amazonaws.com:8082
VITE_PRODUCT_SERVICE_URL=http://localhost:8082
