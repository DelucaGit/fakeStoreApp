# Copy to ".env" next to docker-compose.yml. Docker Compose loads .env automatically.
# Never commit .env.

# --- PostgreSQL (postgres service + same credentials for Spring JDBC) ---
POSTGRES_USER=cloudstore
POSTGRES_PASSWORD=your-local-password-here
POSTGRES_DB=users_and_orders_db

# --- userOrderService (required; no defaults in application.properties) ---
AUTH_ENDPOINT_REGISTER=/api/users/register
AUTH_ENDPOINT_USER_FETCH=/api/users/**
# Use a long random string for real use (signing keys).
JWT_SECRET_KEY=replace-with-long-random-secret

# --- Optional overrides ---
# PRODUCT_SERVICE_BASE_URL=http://product-service:8082
# CORS_ALLOWED_ORIGINS=http://localhost:5173
